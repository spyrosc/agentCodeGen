#******************************************************************
# LLM provider
#******************************************************************
LLM=llama2                # any Ollama tag, gpt-4o, gpt-3.5-turbo, claude-* (Anthropic API),
                          # claudev2, any AWS Bedrock model id, or gemini-*
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=600          # per-request timeout in seconds; 0 disables
LLM_MAX_RETRIES=2          # provider retries on transient errors (not Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Provider credentials (only the ones you actually use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_TOKENS=8192  # max output tokens per Claude response
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

#******************************************************************
# Sandbox
#******************************************************************
# Host directory mounted into both agent and sandbox containers.
WORKSPACE_HOST_DIR=./workspaces
# Path inside both containers. Keep aligned with the bind mount target.
WORKSPACE_ROOT=/workspaces
# Container name the agent shells into via `docker exec`.
SANDBOX_CONTAINER=genai-sandbox
SANDBOX_TIMEOUT_S=180
# Truncation budgets for file reads / command output handed to the LLM.
SANDBOX_MAX_FILE_BYTES=64000
SANDBOX_MAX_OUTPUT_CHARS=8000

#******************************************************************
# Agent runtime
#******************************************************************
AGENT_MAX_ITERATIONS=40

#******************************************************************
# Fullstack agent
#******************************************************************
# Database image written into each generated project's docker-compose.yml.
FULLSTACK_POSTGRES_IMAGE=postgres:16-alpine

#******************************************************************
# Logging / tracing (optional)
#******************************************************************
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=
LANGCHAIN_API_KEY=
